      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhisperShortcut records your voice only while you have started a recording, and turns it into text."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhisperShortcut nimmt Ihre Stimme nur auf, solange Sie eine Aufnahme gestartet haben, und macht daraus Text."
