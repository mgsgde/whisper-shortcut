      }
    },
    "❌ File Too Large\n\nThe audio file is larger than %@ and cannot be transcribed.\nPlease use a shorter recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "❌ Datei zu groß\n\nDie Audiodatei ist größer als %@ und kann nicht transkribiert werden.\nBitte verwenden Sie eine kürzere Aufnahme."
          }
        }
      }
    },
    "❌ Incorrect API Key" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "❌ Falscher API-Schlüssel"
          }
        }
      }
    },
    "❌ Incorrect API Key\n\nThe API key provided is not correct.\nPlease ensure the API key is correct and that you have added your payment details and activated the API key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "❌ Falscher API-Schlüssel\n\nDer angegebene API-Schlüssel ist nicht korrekt.\nPrüfen Sie, ob der Schlüssel stimmt, Zahlungsdaten hinterlegt sind und der Schlüssel aktiviert ist."
          }
        }
      }
    },
    "❌ Invalid Authentication" : {
