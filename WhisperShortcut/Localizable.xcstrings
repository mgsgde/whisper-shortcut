            "value" : "Denkaufwand:"
          }
        }
      }
    },
    "This change is no longer on record." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderung ist nicht mehr verzeichnet."
          }
        }
      }
    },
    "This chat can use **all %lld shared folders** again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat kann wieder **alle %lld freigegebenen Ordner** nutzen."
