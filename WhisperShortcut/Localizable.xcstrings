      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic berechnet über Ihren API-Schlüssel 10 $ pro 1.000 Suchen, dazu die Tokens der Ergebnisse. Claude sucht höchstens fünfmal pro Nachricht und nur, wenn eine Frage aktuelle Informationen braucht."
          }
        }
      }
    },
