        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "❌ Serverfehler"
          }
        }
      }
    },
    "❌ Server Error (%lld)\n\nThe AI provider returned an error.\nPlease try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "❌ Serverfehler (%lld)\n\nDer KI-Anbieter hat einen Fehler gemeldet.\nBitte versuchen Sie es später erneut."
