    },
    "You just updated. Replay the Welcome Tour below, or read the full notes on GitHub." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben gerade aktualisiert. Sehen Sie sich unten die Einführung noch einmal an oder lesen Sie die vollständigen Hinweise auf GitHub."
          }
        }
      }
    },
    "You're connected" : {
