      }
    },
    "❌ Network Error\n\nError: %@\n\nPlease check your internet connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "❌ Netzwerkfehler\n\nFehler: %@\n\nBitte prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        }
      }
    },
    "❌ Permission Denied\n\nYou don't have permission to access this resource.\nPlease check your API key permissions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
