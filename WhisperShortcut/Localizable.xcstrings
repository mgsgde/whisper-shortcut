          }
        }
      }
    },
    "No key required — audio never leaves your Mac. %@ transcribes 25 European languages, German and English included, in a fraction of a second. For other languages, pick a Whisper model later in Settings → Dictate." : {
      "localizations" : {
        "de" : {
