            "value" : "❌ Ungültige Anmeldung"
          }
        }
      }
    },
    "❌ Invalid Request\n\nThe request was malformed or contained invalid parameters.\nPlease check your audio file format and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
