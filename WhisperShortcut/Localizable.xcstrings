            "state" : "translated",
            "value" : "Das können Sie jederzeit unter Einstellungen → Datenschutz & Berechtigungen ändern."
          }
        }
      }
    },
    "You can revisit this tour any time from Settings → About." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Tour finden Sie jederzeit wieder unter Einstellungen → Über."
