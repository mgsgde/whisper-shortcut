    "%@ Check these words before you save the note." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Prüfen Sie diese Wörter, bevor Sie die Notiz sichern."
          }
        }
      }
    },
    "%@ Dictating — meeting still recording" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Diktat läuft – Meeting wird weiter aufgenommen"
          }
        }
      }
    },
    "%@ Error" : {
      "comment" : "Popup title; the argument is the kind of operation that failed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Fehler"
          }
        }
      }
    },
    "%@ ignores the system prompt below — it is a pure speech-recognition model, not an instructable one. Filler-word removal, punctuation and formatting rules have no effect; your Glossary still applies, as keyword hints. Pick a Gemini model or GPT-4o Transcribe if you want the prompt honoured." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignoriert den System-Prompt unten, es ist ein reines Spracherkennungsmodell und nimmt keine Anweisungen an. Regeln zu Füllwörtern, Satzzeichen und Formatierung wirken nicht; Ihr Glossar gilt weiterhin, als Stichwort-Hinweise. Wählen Sie ein Gemini-Modell oder GPT-4o Transcribe, wenn der Prompt beachtet werden soll."
          }
        }
      }
    },
    "%@ is temporarily unavailable. Please try again in a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gerade nicht erreichbar. Bitte versuchen Sie es in ein paar Sekunden noch einmal."
          }
        }
      }
    },
    "%@ of the meeting couldn't be transcribed yet: %@\n\nThe audio is kept on this Mac. Retry once you're back online — here, or with Retry Meeting Transcription in the menu bar menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ des Meetings konnten noch nicht transkribiert werden: %2$@\n\nDie Aufnahme bleibt auf diesem Mac. Versuchen Sie es erneut, sobald Sie wieder online sind – hier oder mit „Meeting-Transkription wiederholen“ im Menüleisten-Menü."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of the meeting couldn't be transcribed yet: %2$@\n\nThe audio is kept on this Mac. Retry once you're back online — here, or with Retry Meeting Transcription in the menu bar menu."
          }
        }
      }
    },
    "%@ ready — you can continue." : {
      "localizations" : {
