    "Request Timeout" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung"
          }
        }
      }
    },
    "Requests to your own machine or local network still work, so a Whisper server or Ollama on this network stays available. Downloading a speech or MLX model from Hugging Face still works (it carries no content of yours)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfragen an diesen Rechner oder das lokale Netz funktionieren weiter, ein Whisper-Server oder Ollama im eigenen Netz bleibt also erreichbar. Sprach- oder MLX-Modelle lassen sich weiter von Hugging Face laden (dabei werden keine Inhalte von Ihnen übertragen)."
          }
        }
      }
    },
    "Required" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich"
          }
        }
      }
    },
    "Required. Dictation through OpenRouter will fail until you connect an account or set this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich. Das Diktat über OpenRouter schlägt fehl, bis Sie ein Konto verbinden oder dies festlegen."
          }
        }
      }
    },
    "Required. Dictation will fail until you set this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich. Das Diktat schlägt fehl, bis Sie dies festlegen."
          }
        }
      }
    },
    "Requires an API key for cloud voice models (Settings → Accounts). The on-device macOS voice needs none, and is selected automatically in Offline Mode. Gemini also works via sign in with Google." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud-Stimmen brauchen einen API-Schlüssel (Einstellungen → Konten). Die lokale macOS-Stimme braucht keinen und wird im Offline-Modus automatisch gewählt. Gemini funktioniert auch über die Anmeldung mit Google."
          }
        }
      }
    },
    "Reset all to defaults" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf Standard zurücksetzen"
          }
        }
