    },
    "Authentication required. Add your API key in Settings → Accounts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldung erforderlich. Fügen Sie Ihren API-Schlüssel unter Einstellungen → Konten hinzu."
