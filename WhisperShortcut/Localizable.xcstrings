    "Audio file not found" : {},
    "Audio from a meeting that couldn't be transcribed (for example while offline) is kept on this Mac until it is." : {},
    "Audio is long - splitting into chunks for processing..." : {},
    "Audio is sent as a chat message (OpenRouter has no dedicated transcription endpoint), so your Dictation system prompt and Glossary apply here — unlike the OpenAI and self-hosted transcription endpoints. Temperature below applies too; Thinking effort is Gemini-only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wird als Chat-Nachricht gesendet (OpenRouter hat keinen eigenen Transkriptions-Endpunkt). Deshalb gelten hier Ihr Diktat-System-Prompt und Ihr Glossar, anders als bei OpenAI und eigenen Transkriptions-Servern. Die Temperatur unten gilt ebenfalls, der Denkaufwand nur bei Gemini."
          }
        }
      }
    },
    "Audio is too long for OpenAI Dictate Prompt (%@ MB > %@ MB limit). Switch to a Gemini Dictate Prompt model for longer recordings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Audio is too long for OpenAI Dictate Prompt (%1$@ MB > %2$@ MB limit). Switch to a Gemini Dictate Prompt model for longer recordings."
          }
        }
      }
    },
