<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>com.apple.security.app-sandbox</key>
		<true />

		<!-- Microphone access for audio recording -->
		<key>com.apple.security.device.audio-input</key>
		<true />

		<!-- Network access for Google Gemini API -->
		<!-- Loopback listener for the OpenRouter OAuth callback (LoopbackOAuthListener). Binds
		     127.0.0.1 only; OpenRouter does not accept custom URL schemes as callback_url. -->
		<key>com.apple.security.network.server</key>
		<true/>
		<key>com.apple.security.network.client</key>
		<true />

		<!-- User selected file access: read for Attach, write for saving screenshots to a chosen folder -->
		<key>com.apple.security.files.user-selected.read-write</key>
		<true />

		<!-- Sparkle 2 installer launcher XPC (sandboxed auto-update) -->
		<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
		<array>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
		</array>
		<!-- Data protection keychain (KeychainManager). Pins the app's keychain access group to
		     TeamID.bundleID so API keys are readable by every build signed by this team, with no
		     per-binary "allow" password prompt. Restricted entitlement: requires a provisioning
		     profile (Xcode-managed team profile for Debug, WhisperShortcut_DeveloperID_CI for
		     Release). Ad-hoc builds strip it (scripts/rebuild-and-restart.sh) and KeychainManager
		     falls back to the legacy file keychain. Follows PRODUCT_BUNDLE_IDENTIFIER, so the Debug
		     build (….whispershortcut.dev) keeps its own keys apart from the installed release. -->
		<key>keychain-access-groups</key>
		<array>
			<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		</array>

		<!-- Reads AppleFnUsageType so Fn dictation can default on only when macOS's
		     "Press 🌐 key to" is "Do Nothing". Read-only; the app never writes this domain. -->
		<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
		<array>
			<string>com.apple.HIToolbox</string>
		</array>
	</dict>
</plist>
