{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:platform.openai.com)",
      "WebFetch(domain:ai.google.dev)",
      "Bash(bash scripts/rebuild-and-restart.sh*)",
      "Bash(bash scripts/create-release.sh*)",
      "Bash(bash scripts/logs.sh*)",
      "Bash(xcodebuild -project WhisperShortcut.xcodeproj -scheme WhisperShortcut*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/ensure-app-running.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
