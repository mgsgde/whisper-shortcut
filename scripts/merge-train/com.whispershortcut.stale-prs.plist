<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stale PRs: Mondays at 08:30, mail every open PR against main that is older than 3 days
  and close those open 14 days (branch kept). See scripts/merge-train/README.md.

  Install / remove (after this is on main — see the bootstrap note below):
      bash scripts/merge-train/install.sh
      bash scripts/merge-train/install.sh --remove

  The command bootstraps from origin/main rather than running the tree's copy, same as the
  implementer tick: the shared checkout may be on any branch. Falls back to the working tree
  when origin/main cannot be read. The script only reads origin; it never changes a checkout.

  launchd does not expand $HOME in StandardOutPath, so the log paths below carry a __HOME__
  placeholder that install.sh replaces with the real home directory when it copies the file.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.whispershortcut.stale-prs</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>cd "$HOME/whisper-shortcut-private/whisper-shortcut" || exit 0
git fetch -q origin main 2>/dev/null
T=/tmp/whispershortcut-stale-prs-main.sh
if git show origin/main:scripts/merge-train/stale-prs.sh &gt;"$T" 2>/dev/null &amp;&amp; [ -s "$T" ]; then
  MERGE_TRAIN_REPO_ROOT="$HOME/whisper-shortcut-private/whisper-shortcut" exec bash "$T"
fi
exec bash scripts/merge-train/stale-prs.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/whispershortcut-merge-train/stale-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/whispershortcut-merge-train/stale-launchd.log</string>
  </dict>
</plist>
